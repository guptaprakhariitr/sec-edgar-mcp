{
  "$schema": "https://smithery.ai/schema/server.json",
  "name": "sec-edgar-mcp",
  "displayName": "SEC EDGAR",
  "description": "Search SEC filings, read 10-Ks and 8-Ks, query XBRL financial facts, and track insider trades. Free underlying data; hosted on Cloudflare Workers.",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://sec-edgar-mcp.workers.dev",
  "repository": "https://github.com/guptaprakhariitr/sec-edgar-mcp",
  "categories": ["finance", "research", "regulatory", "data"],
  "tags": ["sec", "edgar", "10-k", "8-k", "xbrl", "stocks", "filings", "insider-trading"],
  "transport": {
    "type": "http",
    "url": "https://sec-edgar-mcp.workers.dev/mcp"
  },
  "auth": {
    "type": "bearer",
    "tokenUrl": "https://sec-edgar-mcp.workers.dev/account/keys",
    "freeTier": {
      "monthlyCalls": 100,
      "ratePerMinute": 10,
      "note": "no API key required — anonymous requests get free-tier quota"
