  },
  "tools": [
    "edgar_search_filings",
    "edgar_read_filing",
    "edgar_get_facts",
    "edgar_get_8k",
    "edgar_get_company",
    "edgar_get_insider_trades"
  ],
  "pricing": {
    "currency": "USD",
    "tiers": [
      { "name": "Free", "price": 0, "monthlyCalls": 100 },
      { "name": "Solo", "price": 9, "monthlyCalls": 2000 },
      { "name": "Team", "price": 29, "monthlyCalls": 10000 },
      { "name": "Pro",  "price": 79, "monthlyCalls": 50000 }
    ]
  },
  "support": {
    "issues": "https://github.com/guptaprakhariitr/sec-edgar-mcp/issues",
    "email": "prakshatechnologies@gmail.com"
  }
